---
import { AppContainer } from '../components/app/AppContainer';
import '../styles/quiz.css';

// Prerendered so the static S3 and CloudFront deploy serves the app
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Practise quizzes in an exam-style interface, built from your own notes."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Quiz Drill</title>
  </head>
  <body class="bg-[#f8fafc] font-sans text-gray-900 antialiased">
    <AppContainer client:only="react" />
    <noscript>Quiz Drill needs JavaScript to run quizzes.</noscript>
  </body>
</html>
