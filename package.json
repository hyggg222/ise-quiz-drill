{
  "name": "ise-quiz-drill",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test:unit:run": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:podman": "podman run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^3.4.19",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
